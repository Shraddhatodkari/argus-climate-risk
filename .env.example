# Optional — only needed for the cloud LLM path. The system runs fully
# offline/local by default via Ollama; nothing here is required for ₹0 operation.
ANTHROPIC_API_KEY=

# Local LLM served by Ollama (default): http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Vector store location
CHROMA_PERSIST_DIR=./data/processed/chroma

# Logging
ARGUS_LOG_LEVEL=INFO
