# Optional. The pipeline runs fully offline by default via the deterministic
# `template` LLM backend (zero network, zero cost, no key required). Set
# ARGUS_LLM_MODE to opt into a real model for free-text narrative/RAG answers:
#
#   ARGUS_LLM_MODE=template   # default -- deterministic, no network
#   ARGUS_LLM_MODE=ollama     # requires a local Ollama server (below)
#   ARGUS_LLM_MODE=claude     # requires ANTHROPIC_API_KEY (below)
ARGUS_LLM_MODE=template

# Only used when ARGUS_LLM_MODE=claude.
ANTHROPIC_API_KEY=

# Only used when ARGUS_LLM_MODE=ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Logging
ARGUS_LOG_LEVEL=INFO
